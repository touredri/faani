rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function phoneIndexPath(phoneE164) {
      return /databases/$(database)/documents/phone_index/$(phoneE164);
    }

    // Identity mapping: one phoneE164 -> one uid
    match /phone_index/{phoneE164} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneE164 == phoneE164
        && !exists(phoneIndexPath(phoneE164));
      allow update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.phoneE164 == phoneE164;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.id == uid;
      allow delete: if isSelf(uid);
    }

    match /modele/{modeleId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.idTailleur == request.auth.uid;
    }

    match /categorie/{catId} {
      allow read: if true;
      allow write: if false; // Admin only via console
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
